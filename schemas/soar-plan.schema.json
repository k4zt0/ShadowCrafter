{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odytssey.example/shadowcrafter/schemas/soar-plan.schema.json",
  "title": "ShadowCrafter Human-Approved SOAR Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "title",
    "incident_reference",
    "rationale",
    "steps",
    "human_approval_required",
    "dry_run_only",
    "autonomous_execution_allowed",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "incident_reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 6000 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SOARStep" }
    },
    "human_approval_required": { "const": true },
    "dry_run_only": { "const": true },
    "autonomous_execution_allowed": { "const": false },
    "status": { "const": "draft_pending_approval" }
  },
  "$defs": {
    "SOARStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "action_type",
        "description",
        "target_reference",
        "approval",
        "rollback",
        "execution_status",
        "executable_content_included"
      ],
      "properties": {
        "step_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "action_type": {
          "enum": [
            "enrich",
            "collect_evidence",
            "notify",
            "open_case",
            "propose_block",
            "propose_isolation",
            "propose_quarantine"
          ]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "target_reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "status", "approver_role", "separation_of_duties"],
          "properties": {
            "required": { "const": true },
            "status": { "const": "pending" },
            "approver_role": { "type": "string", "minLength": 1, "maxLength": 160 },
            "separation_of_duties": { "const": true }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "verification", "owner_role"],
          "properties": {
            "description": { "type": "string", "minLength": 1, "maxLength": 3000 },
            "verification": { "type": "string", "minLength": 1, "maxLength": 3000 },
            "owner_role": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        "execution_status": { "const": "not_executed" },
        "executable_content_included": { "const": false }
      },
      "not": {
        "anyOf": [
          { "required": ["command"] },
          { "required": ["script"] },
          { "required": ["payload"] }
        ]
      }
    }
  }
}
