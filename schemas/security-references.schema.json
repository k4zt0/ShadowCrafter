{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odytssey.example/shadowcrafter/schemas/security-references.schema.json",
  "title": "ShadowCrafter STIX or SARIF Reference",
  "oneOf": [
    { "$ref": "#/$defs/STIXReference" },
    { "$ref": "#/$defs/SARIFReference" }
  ],
  "$defs": {
    "STIXReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stix_id", "object_type", "spec_version"],
      "properties": {
        "kind": { "const": "stix" },
        "stix_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "object_type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "spec_version": { "enum": ["2.0", "2.1"] },
        "source_uri": { "type": ["string", "null"], "maxLength": 2048 }
      }
    },
    "SARIFReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_uri", "rule_id", "result_index"],
      "properties": {
        "kind": { "const": "sarif" },
        "artifact_uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "rule_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "result_index": { "type": "integer", "minimum": 0 },
        "run_id": { "type": ["string", "null"], "maxLength": 200 },
        "region_start_line": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
