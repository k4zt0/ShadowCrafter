| Prepared by | {{ prepared_by | default("Not recorded", true) }} |
| Human reviewers | {{ reviewers | default([], true) | join(", ") or "Not assigned" }} |
| Model assistance | {{ model.name | default("Not used or not recorded", true) }} |
| Model revision | {{ model.revision | default("Not recorded", true) }} |
| Evaluation status | {{ evaluation.status | default("Not evaluated", true) }} |

