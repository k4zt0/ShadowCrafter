{#
  ShadowCrafter defensive security-assessment template.

  Expected context (all values may be omitted unless organizational policy says otherwise):
    title, report_id, classification, status, assessment_date, prepared_at_utc,
    prepared_by, reviewers, model, authorization, executive_summary, objectives,
    scope, methodology, limitations, findings, positive_observations, risk_summary,
    recommendations, evidence_register, data_handling, evaluation, approvals,
    appendix, references.

  Do not place credentials, live secrets, malware binaries, weaponized payloads, or
  unnecessary personal data in the rendering context. Findings must be human-reviewed.
#}
{% set model = model | default({}, true) %}
{% set authorization = authorization | default({}, true) %}
{% set scope = scope | default({}, true) %}
{% set methodology = methodology | default({}, true) %}
{% set data_handling = data_handling | default({}, true) %}
{% set evaluation = evaluation | default({}, true) %}
# {{ title | default("Security Assessment", true) }}

> **{{ status | default("DRAFT — HUMAN REVIEW REQUIRED", true) }}**<br>
> This defensive assessment is limited to the authorization and scope recorded below.
> ShadowCrafter output is advisory and must not trigger autonomous high-impact actions.

| Field | Value |
|---|---|
| Report ID | {{ report_id | default("Not assigned", true) }} |
| Classification | {{ classification | default("Internal / need-to-know", true) }} |
| Assessment date | {{ assessment_date | default("Not recorded", true) }} |
